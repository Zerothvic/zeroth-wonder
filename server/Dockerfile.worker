# Use a slim Node.js production image
FROM node:20-slim

# Install system dependencies needed for ffmpeg media pipelines
RUN apt-get update && apt-get install -y \
    ffmpeg \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files first for optimal build caching
COPY package*.json ./
RUN npm ci --only=production

# Copy the rest of your server code
COPY . .

# Trigger the BullMQ background worker script instead of the web API
CMD ["npm", "run", "worker"]